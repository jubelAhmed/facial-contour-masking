
APP_DEBUG=false
APP_APP_NAME="Facial Contour Masking API"
APP_VERSION="1.0.0"


DB_USE_DATABASE=true

# Database connection settings
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=facial_api


AUTH_SECRET_KEY=your-super-secret-jwt-key-change-in-production
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_ALGORITHM=HS256


RATE_LIMIT_ENABLED=true

# Rate limit settings
RATE_LIMIT_REQUESTS_PER_HOUR=100
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_BURST_LIMIT=10

# Redis URL for distributed rate limiting (optional - uses memory if not set)
# RATE_LIMIT_REDIS_URL=redis://localhost:6379

# =============================================================================
# PROMETHEUS MONITORING
# =============================================================================
# Enable/disable Prometheus metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090


ENV=development

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# CORS settings (comma-separated origins, use * for all)
# CORS_ALLOW_ORIGINS=*

# Trusted hosts (comma-separated, use * for all)
# TRUSTED_HOSTS=*

# =============================================================================
# REDIS CONFIGURATION (for rate limiting and caching)
# =============================================================================
# Redis connection URL
# REDIS_URL=redis://localhost:6379

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Set to true for development mode
# DEV_MODE=true

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
# Set to true for production mode
# PROD_MODE=false

# =============================================================================
# DOCKER SETTINGS
# =============================================================================
# Docker environment
# DOCKER_ENV=false
